{
  "name": "main",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "geolib": "^3.0.4",
    "got": "^9.6.0",
    "react": "^16.11.0",
    "react-dom": "^16.10.1",
    "react-scripts": "5.0.1",
    "styled-components": "^4.4.1",
    "typescript": "^3.6.3"
  },
  "devDependencies": {
    "@josefaidt/eslint-config": "^0.1.9",
    "@josefaidt/prettier-config": "0.0.2",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^1.18.2"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "eslintConfig": {
    "extends": "@josefaidt/eslint-config",
    "parserOptions": {
      "ecmaVersion": 9,
      "sourceType": "module"
    }
  },
  "prettier": "@josefaidt/prettier-config",
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "git add"
    ],
    "*.{md,mdx,json}": [
      "prettier --write",
      "git add"
    ]
  }
}
